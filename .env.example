# Database
DATABASE_URL="postgresql://user:password@localhost:5432/criteriadesigns?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Upload directory (for production, consider S3)
UPLOAD_DIR="./public/uploads"

# Maintenance mode — shows the "under construction" page on the domains listed
# in MAINTENANCE_DOMAIN, while /admin, /api, and any other domain keep working.
MAINTENANCE_MODE="false"
MAINTENANCE_DOMAIN="criteriadesigns.com,www.criteriadesigns.com"
